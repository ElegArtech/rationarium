{
  "name": "@rationarium/api",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Serveur applicatif : NestJS sur adaptateur Fastify",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../../docs/references/calendrier/periodes-metropole.json dist/parametrage/periodes-metropole.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "perf": "vitest run --config vitest.int.config.ts src/perf",
    "amorcer": "node dist/exploitation/amorcage.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.6",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@rationarium/contracts": "workspace:*",
    "@rationarium/db": "workspace:*",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "fastify": "5.12.5",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.0.15",
    "pg-boss": "12.36.0",
    "pino": "10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "license": "MIT",
  "author": "Alexandre Bergé",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElegArtech/rationarium.git"
  }
}

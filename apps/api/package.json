{
  "name": "@trame/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serveur applicatif : NestJS sur adaptateur Fastify",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/swagger": "11.4.6",
    "@node-rs/argon2": "2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@trame/contracts": "workspace:*",
    "@trame/db": "workspace:*",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "fastify": "5.12.0",
    "nestjs-zod": "5.5.0",
    "nodemailer": "9.0.5",
    "pg-boss": "12.27.0",
    "pino": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

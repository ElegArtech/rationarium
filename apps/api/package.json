{
  "name": "@trame/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serveur applicatif : NestJS sur adaptateur Fastify",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@trame/contracts": "workspace:*",
    "@trame/db": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "fastify": "5.12.0",
    "zod": "4.4.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

{
  "name": "@rationarium/db",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Schéma Prisma, migrations et client typé",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mesure": {
      "types": "./dist/mesure.d.ts",
      "default": "./dist/mesure.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:export": "node dist/reversibilite-cli.js",
    "db:maquette": "node dist/maquette-cli.js",
    "db:purge-volumetrie": "node dist/purge-volumetrie-cli.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "@rationarium/contracts": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "^8.21.0",
    "pg": "8.16.3",
    "prisma": "7.9.1",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "author": "Alexandre Bergé",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElegArtech/rationarium.git"
  }
}

{
  "name": "rationarium",
  "version": "0.0.0",
  "private": true,
  "description": "Rationarium — plateforme de pilotage des projets et des ressources humaines",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "stylelint": "stylelint \"apps/web/src/**/*.css\"",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "e2e": "turbo run e2e",
    "a11y": "turbo run a11y",
    "i18n:check": "node scripts/i18n-check.mjs",
    "ui:diff": "node scripts/ui-diff.mjs",
    "perf": "turbo run perf",
    "verif": "pnpm typecheck && pnpm lint && pnpm stylelint && pnpm i18n:check && pnpm inoperant:check && pnpm tracabilite:check && pnpm test",
    "conformite": "node scripts/ui-conformite.mjs toutes",
    "inoperant:check": "node scripts/inoperant-check.mjs",
    "tracabilite:check": "node scripts/tracabilite-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "oxlint": "1.78.0",
    "pg": "8.16.3",
    "playwright": "1.62.1",
    "stylelint": "17.14.1",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}

{
  "name": "rationarium",
  "version": "1.0.2",
  "private": true,
  "description": "Rationarium — plateforme de pilotage des projets et des ressources humaines",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "stylelint": "stylelint \"apps/web/src/**/*.css\"",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "e2e": "turbo run e2e",
    "a11y": "turbo run a11y",
    "i18n:check": "node scripts/i18n-check.mjs",
    "perf": "turbo run perf",
    "verif": "pnpm typecheck && pnpm lint && pnpm stylelint && pnpm i18n:check && pnpm inoperant:check && pnpm tracabilite:check && pnpm test && pnpm test:livraison && pnpm livraison:check",
    "inoperant:check": "node scripts/inoperant-check.mjs",
    "tracabilite:check": "node scripts/tracabilite-check.mjs",
    "livraison:check": "node scripts/livraison-check.mjs --stable",
    "test:livraison": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "oxlint": "1.87.0",
    "pg": "8.23.1",
    "playwright": "1.63.0",
    "stylelint": "17.16.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "license": "MIT",
  "author": "Alexandre Bergé",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElegArtech/rationarium.git"
  }
}

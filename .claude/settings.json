{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/garde-ecriture.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/apres-ecriture.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Une tâche de ce dépôt n'est terminée que si ses critères d'acceptation sont DÉMONTRÉS, pas seulement traités. Vérifie dans la conversation : les commandes de vérification ont-elles été exécutées et leur sortie montrée ? Si un critère du contrat de tâche ou de la définition de terminé de CLAUDE.md reste non démontré, réponds {\"ok\": false, \"reason\": \"<ce qui reste à démontrer>\"}. Si aucune tâche d'implémentation n'est en cours — conversation, lecture, analyse, rédaction de document — réponds {\"ok\": true}."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm stylelint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:int)",
      "Bash(pnpm verif)",
      "Bash(pnpm build)",
      "Bash(pnpm i18n:check)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec stylelint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}

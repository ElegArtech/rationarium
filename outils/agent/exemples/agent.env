# Configuration de l'agent de référence de Rationarium.
# À copier dans ~/.config/rationarium-agent/agent.env (droits 600).
# Une variable d'environnement déjà posée l'emporte sur ce fichier.
# Seules les clés RATIONARIUM_… sont lues. Une valeur peut être entourée de guillemets.

# Adresse de l'instance. Le préfixe /api/agent/v1 est ajouté s'il manque.
RATIONARIUM_URL=https://localhost:8443

# Certificat racine de l'instance, quand il n'est pas reconnu par le système.
# Il est chargé par NODE_EXTRA_CA_CERTS ; la vérification TLS n'est jamais désactivée.
#RATIONARIUM_CA=/home/utilisateur/.config/rationarium-agent/ca.pem

# Le jeton se range de préférence dans le trousseau :
#   secret-tool store --label='Rationarium agent' service rationarium-agent usage jeton
# À défaut seulement, il s'écrit ici. Il serait alors visible du client de modèle de langage.
#RATIONARIUM_JETON=rat_...

# Commande lancée par le relais pour chaque passage, par bash, dans le dossier du passage.
# Par défaut : Claude Code, avec la consigne consignes/claude-code.md.
#RATIONARIUM_COMMANDE='claude -p "$(cat "$RATIONARIUM_CONSIGNE_PASSAGE")" --permission-mode acceptEdits --allowedTools "$RATIONARIUM_OUTILS_CLAUDE"'

# Outils ajoutés à la liste permise à Claude Code, par exemple l'outil de recherche du courrier.
#RATIONARIUM_OUTILS_SUPPLEMENTAIRES='Bash(notmuch search *) Bash(notmuch show *)'

# Pour Codex à la place de Claude Code :
#RATIONARIUM_CONSIGNE=/home/utilisateur/.local/share/rationarium-agent/consignes/codex.md
#RATIONARIUM_COMMANDE='codex exec --sandbox workspace-write -c sandbox_workspace_write.network_access=true --skip-git-repo-check -C "$RATIONARIUM_DOSSIER_PASSAGE" "$(cat "$RATIONARIUM_CONSIGNE_PASSAGE")"'

# Durée maximale d'une exécution, en minutes.
#RATIONARIUM_DUREE_MAX=180

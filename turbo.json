{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prisma/schema.prisma",
        "src/generated/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prisma/schema.prisma",
        "src/generated/**"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prisma/schema.prisma",
        "src/generated/**"
      ]
    },
    "test:int": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "a11y": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "perf": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

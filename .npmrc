# Versions exactes : le socle technique (cadrage/03 § 9) épingle chaque brique.
# Une montée de version est une décision, pas un effet de bord d'installation.
save-exact=true
engine-strict=true

# Réseau fermé (C1) : la construction de l'image de production doit se faire
# sans accès sortant, à partir du fichier de verrouillage. Contrôle en
# intégration continue. Voir docs/adr/ADR-0013.
prefer-frozen-lockfile=true

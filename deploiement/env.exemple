# ════════════════════════════════════════════════════════════════════════════
# Rationarium — variables de déploiement. À copier en `.env` et à renseigner :
#
#     cp env.exemple .env
#
# Le fichier `.env` ne se versionne pas. Les valeurs marquées OBLIGATOIRE n'ont
# pas de défaut : Compose refuse de démarrer si elles manquent, plutôt que de
# lancer une instance avec un secret prévisible.
# ════════════════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────────────
POSTGRES_UTILISATEUR=rationarium          # OBLIGATOIRE
POSTGRES_MOTDEPASSE=                # OBLIGATOIRE — à engendrer, pas à choisir
POSTGRES_BASE=rationarium

# ── Application ─────────────────────────────────────────────────────────────
# OBLIGATOIRE. Signe les cookies de session. Le changer déconnecte tout le
# monde ; le divulguer compromet toutes les sessions. À engendrer par :
#   openssl rand -base64 48
COOKIE_SECRET=

# Nom par lequel les postes joignent le service. Il doit résoudre sur le
# réseau interne ; c'est aussi le nom porté par le certificat.
RATIONARIUM_HOTE=rationarium.collectivite.local
RATIONARIUM_PORT_HTTP=80
RATIONARIUM_PORT_HTTPS=443

# Fuseau de l'organisation. Il porte l'heure des travaux périodiques
# (`RG-NTF-01`) et l'horodatage du journal d'audit.
RATIONARIUM_FUSEAU=Europe/Paris

# Heure de l'envoi quotidien des alertes d'échéance, en expression cron.
RATIONARIUM_CRON_ALERTES=0 7 * * *

# ── Premier administrateur ──────────────────────────────────────────────────
# Employées par le service `amorcage`, au tout premier démarrage seulement.
# Laisser `RATIONARIUM_ADMIN_MOTDEPASSE` vide fait ENGENDRER un mot de passe, affiché
# une fois dans le journal du service — c'est le choix recommandé : un mot de
# passe écrit ici y resterait des années. Il est à changer à la première
# connexion dans les deux cas.
RATIONARIUM_ADMIN_LOGIN=admin
RATIONARIUM_ADMIN_EMAIL=admin@collectivite.local
RATIONARIUM_ADMIN_MOTDEPASSE=

# ── Messagerie ──────────────────────────────────────────────────────────────
# Facultatif. Sans `SMTP_HOTE`, les courriels sont journalisés au lieu d'être
# envoyés, et l'application fonctionne normalement (`RG-NTF-04`).
SMTP_HOTE=
SMTP_PORT=25
# Un relais interne n'a pas toujours de certificat signé par une autorité
# publique : le chiffrement reste un choix explicite de l'exploitant.
SMTP_TLS=false
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=

# ── Sauvegarde ──────────────────────────────────────────────────────────────
# Employées par `sauvegarde.sh`. La rétention est en jours.
RATIONARIUM_SAUVEGARDES=/var/sauvegardes/rationarium
RATIONARIUM_RETENTION=30

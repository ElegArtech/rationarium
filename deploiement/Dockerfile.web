FROM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS construction
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
WORKDIR /rationarium

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @rationarium/contracts build && pnpm --filter @rationarium/web build

# Caddy 2.11.7 recompilé : l'image officielle embarque un binaire construit avec
# Go 1.26.8, golang.org/x/net 0.59.0 et go-jose 4.1.5, qui portent des failles
# corrigées en amont. L'image de construction officielle fournit Go 1.27.3 ;
# xcaddy produit la même distribution standard, avec ces deux modules corrigés.
FROM caddy:2.11.7-builder-alpine@sha256:95a5e7e2692b5eb9545aadc5b90a39f6f509bee59c9508a493f83ee902eaef63 AS caddy
RUN xcaddy build v2.11.7 \
      --output /usr/bin/caddy \
      --replace golang.org/x/net=golang.org/x/net@v0.62.0 \
      --replace github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@v4.1.6

FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS execution
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
# L'image Caddy est reconstruite moins souvent que ses paquets Alpine : curl et
# brotli y portaient des failles corrigées en amont. On les reprend au build.
RUN apk upgrade --no-cache
LABEL org.opencontainers.image.source="https://github.com/ElegArtech/rationarium" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Rationarium Web"
COPY --from=construction /rationarium/apps/web/dist /srv
COPY deploiement/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/rationarium/

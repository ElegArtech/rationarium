FROM node:26.11.1-bookworm-slim@sha256:86f07bc9c5dce4578cf37e5a418b7bfc7f817cda25cde66e2b66e95ed86c4567 AS construction
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
WORKDIR /rationarium

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @rationarium/contracts build && pnpm --filter @rationarium/web build

FROM caddy:2.11.6-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9 AS execution
LABEL org.opencontainers.image.source="https://github.com/ElegArtech/rationarium" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Rationarium Web"
COPY --from=construction /rationarium/apps/web/dist /srv
COPY deploiement/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/rationarium/

{
	admin off
	{$DIRECTIVE_COURRIEL_ACME}
}

:80 {
	@sonde path /_sante
	respond @sonde 200
}

{$RATIONARIUM_HOTE:http://localhost} {
	{$DIRECTIVE_TLS}
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$RATIONARIUM_API:api:3000}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
	@empreinte path_regexp \-[A-Za-z0-9_-]{8,}\.(js|css|woff2)$
	header @empreinte Cache-Control "public, max-age=31536000, immutable"
	@volatil not path_regexp \-[A-Za-z0-9_-]{8,}\.(js|css|woff2)$
	header @volatil Cache-Control "no-cache"
}

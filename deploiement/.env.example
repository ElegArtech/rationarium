# Copier en .env, ou lancer bash configurer.sh.
NOM_PROJET=rationarium
VERSION_RATIONARIUM=1.0.1
REGISTRE_RATIONARIUM=ghcr.io/elegartech
# missing télécharge les images absentes ; never interdit tout téléchargement.
MODE_IMAGES=missing

# Propriétaire de la base : migrations, sauvegarde et restauration seulement.
POSTGRES_UTILISATEUR=rationarium
# Rôle de connexion de l'application, sans droit d'administration ; son mot de
# passe est engendré au premier démarrage et rangé dans le volume identifiants.
POSTGRES_UTILISATEUR_APPLICATION=rationarium_api
POSTGRES_BASE=rationarium
POSTGRES_MOTDEPASSE=
COOKIE_SECRET=

# Adresse écoutée par Caddy, puis origine exacte vue par le navigateur.
RATIONARIUM_HOTE=http://localhost
RATIONARIUM_URL_PUBLIQUE=http://localhost:8080
RATIONARIUM_PORT_HTTP=8080
RATIONARIUM_PORT_HTTPS=8443
# Adresse de l'hôte sur laquelle ces ports sont publiés. 127.0.0.1 : ce poste
# seulement, pour l'accès HTTP local. Vide : toutes les interfaces, pour HTTPS.
# Une adresse d'interface interne (par exemple 10.88.0.1) limite à ce réseau.
RATIONARIUM_IP_ECOUTE=127.0.0.1
# Pour HTTPS : vide = certificat public automatique ; tls internal = autorité locale.
DIRECTIVE_TLS=
COURRIEL_ACME=
# true interdit les connexions sortantes du serveur et de la base.
RESEAU_INTERNE=false

RATIONARIUM_FUSEAU=Europe/Paris
RATIONARIUM_CRON_ALERTES=0 7 * * *

# Premier compte seulement ; retirer ces valeurs après la première connexion.
# Vide : identifiant engendré (admin-xxxxxx), affiché dans les journaux d'amorçage.
# Éviter « admin » : un identifiant connu permet de verrouiller le compte à distance.
RATIONARIUM_ADMIN_LOGIN=
RATIONARIUM_ADMIN_EMAIL=
# Vide : mot de passe temporaire généré, consultable dans les journaux d’amorçage.
RATIONARIUM_ADMIN_MOTDEPASSE=

# Relais SMTP facultatif. Sans relais, les messages restent dans les journaux privés.
SMTP_HOTE=
SMTP_PORT=25
SMTP_TLS=false
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_EXPEDITEUR=rationarium@localhost

# Sauvegardes locales ; à copier sur un stockage distinct.
RATIONARIUM_SAUVEGARDES=./sauvegardes
# 0 conserve tous les jeux ; une valeur positive fixe la rétention en jours.
RATIONARIUM_RETENTION=0

# Renseigné par migrer-postgresql.sh ; laisser vide pour une installation neuve.
VOLUME_POSTGRES=

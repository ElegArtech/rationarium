# Même majeure PostgreSQL et même libc que rc.1 : les volumes et leurs
# collations restent compatibles. Les correctifs Debian sont intégrés au lot.
FROM postgres:18.6-bookworm@sha256:3725f4e2499eef5134592b3b4ab79a543ed7f8e533b05b5b637af926630f6650
RUN apt-get update \
 && apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.source="https://github.com/ElegArtech/rationarium" \
      org.opencontainers.image.licenses="PostgreSQL" \
      org.opencontainers.image.title="Rationarium PostgreSQL"
